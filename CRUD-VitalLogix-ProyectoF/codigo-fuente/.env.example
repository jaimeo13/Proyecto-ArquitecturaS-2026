# Configuración de MySQL para VitalLogix
MYSQL_DATABASE=vitallogix
MYSQL_USER=vitallogix
MYSQL_PASSWORD=vitallogix123
MYSQL_ROOT_PASSWORD=vitallogix_root_123

# Configuración de Hibernate / JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Secreto JWT (mínimo 32 caracteres para HS256)
JWT_SECRET=VitalLogix_SuperSecret_JWT_Key_2026_Min32Bytes!

# Usuarios iniciales (bootstrap)
APP_BOOTSTRAP_ADMIN_USERNAME=admin1
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123
APP_BOOTSTRAP_DEMO_USER_ENABLED=true
APP_BOOTSTRAP_DEMO_USER_USERNAME=user1
APP_BOOTSTRAP_DEMO_USER_PASSWORD=user123
